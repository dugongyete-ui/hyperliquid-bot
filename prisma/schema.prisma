generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Global bot settings (single row, id = "main")
model Settings {
  id              String   @id @default("main")
  mode            String   @default("sim") // sim | testnet | mainnet
  botName         String   @default("Grok Bot")
  startingEquity  Float    @default(1000)
  goalMultiple    Float    @default(2)
  leverage        Int      @default(5) // 1-20× notional per trade
  positionPct     Float    @default(0.3) // fraction of equity used as margin per trade
  riskProfile     String   @default("balanced") // chill | balanced | turbo
  // Adaptive exit engine: autoExit = TP/SL dihitung per-trade dari volatilitas
  // live (ATR) + rezim market (trending → target dilebar, ranging → diperketat).
  // autoExit = false → pakai tpPct / slPct tetap dari user.
  autoExit        Boolean  @default(true)
  tpPct           Float    @default(1.2) // manual take-profit % (dipakai saat autoExit = false)
  slPct           Float    @default(0.6) // manual stop-loss %   (dipakai saat autoExit = false)
  // allowShort: bot boleh membuka posisi SHORT (untung saat market turun).
  // false = long-only seperti sebelumnya.
  allowShort      Boolean  @default(true)
  // HyperGrok desk risk limits — user may only TIGHTEN, never exceed the hard ceilings
  maxRiskPct      Float    @default(1.0)  // max % of equity at risk per trade (ceiling 2)
  maxTotalRiskPct Float    @default(4.0)  // max % of equity at risk across all open positions (ceiling 6)
  dailyLossStopPct Float   @default(6.0)  // daily loss stop % — latches "no-new-risk" (ceiling 10)
  privateKey      String?  // agent wallet private key (live modes only)
  walletAddress   String?  // optional main wallet address when using an agent wallet
  liveStartEquity Float?   // first observed account value after switching to live
  running         Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

// Every trade (open + closed) placed by the crew
model Trade {
  id         String    @id @default(cuid())
  mode       String // sim | testnet | mainnet
  botKey     String
  coin       String
  side       String    @default("long")
  sizeUsd    Float
  qty        Float     @default(0)
  entryPx    Float
  exitPx     Float?
  peakPx     Float     @default(0) // highest seen price (for trailing stop)
  pnl        Float     @default(0)
  pnlPct     Float     @default(0)
  riskUsd    Float     @default(0) // stressed-stop risk budget at entry ($ that a stop hit costs)
  status     String    @default("open") // open | closed
  reason     String    @default("")
  exitReason String?
  openedAt   DateTime  @default(now())
  closedAt   DateTime?
}

// Equity curve samples
model EquityPoint {
  id        String   @id @default(cuid())
  mode      String
  equity    Float
  createdAt DateTime @default(now())
}

// Resolved original coin icon URLs (CoinGecko), cached forever
model CoinIcon {
  symbol    String   @id
  url       String?
  updatedAt DateTime @updatedAt
}
